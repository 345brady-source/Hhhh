    <div style="text-align: justify; margin-left: 36pt;"><font style="font-size: 12pt;">&#9744; Yes</font><font class="TRGRRTFtoHTMLTab" style="display: inline-block; text-indent: 0px; font-size: 1px; width: 108pt">&#160;</font><font style="font-size: 12pt;">&#9744; No</font></div>
    <div><br>
    </div>
