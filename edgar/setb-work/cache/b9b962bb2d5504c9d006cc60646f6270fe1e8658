<div style="MARGIN-LEFT: 0pt; DISPLAY: block; MARGIN-RIGHT: 0pt; TEXT-INDENT: 0pt" align="left"><font style="FONT-SIZE: 10pt; FONT-FAMILY: Times New Roman; DISPLAY: inline"><!--EFPlaceholder--><font style="FONT-WEIGHT: bold; DISPLAY: inline"><a name="PowerAttorney">Power </a>of Attorney</font></font></div>

