    <tr>

        <td width="5%" valign=top style='padding:6.0pt 0pt 0pt 0pt;'>

<p style='margin-left:0pt;text-indent:0pt;text-align:left;margin-top:2.0pt;margin-bottom:0pt;'><font size=1>&nbsp;</font></p> </td>

        <td width="5%" valign=top style='padding:6.0pt 0pt 0pt 0pt;'>

<p style='margin-left:0pt;text-indent:0pt;text-align:left;margin-bottom:0pt;'><font size=2>(i)</font></p> </td>

        <td valign=top style='padding:6.0pt 0pt 0pt 0pt;'>

<p style='margin-left:0pt;text-indent:0pt;text-align:left;margin-bottom:0pt;'><font size=2>which Affiliated Program has been seeking Investments or reinvesting Cash Flow from its Investments for the longest period of time;</font></p> </td> </tr></table>
</div>






<div align=left>


