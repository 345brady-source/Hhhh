    <tr>

        <td width="10%" valign=top style='padding:6.0pt 0pt 0pt 0pt;'>

<p style='margin-left:0pt;text-indent:0pt;text-align:left;margin-top:2.0pt;margin-bottom:0pt;'><font size=1>&nbsp;</font></p> </td>

        <td width="5%" valign=top style='padding:6.0pt 0pt 0pt 0pt;'>

<p style='margin-left:0pt;text-indent:0pt;text-align:left;margin-bottom:0pt;'><font size=2>(1)</font></p> </td>

        <td valign=top style='padding:6.0pt 0pt 0pt 0pt;'>

<p style='margin-left:0pt;text-indent:0pt;text-align:left;margin-bottom:0pt;'><font size=2>active trade or business income or loss, such as ordinary income from a salary and other types of compensation for personal services;</font></p> </td> </tr></table>
</div>






<div align=left>


<table border="0" cellspacing=0 cellpadding=0 width="100%" style=' border-collapse:collapse;'>
    <tr>

        <td width="10%" valign=top style='padding:6.0pt 0pt 0pt 0pt;'>

<p style='margin-left:0pt;text-indent:0pt;text-align:left;margin-top:2.0pt;margin-bottom:0pt;'><font size=1>&nbsp;</font></p> </td>

        <td width="5%" valign=top style='padding:6.0pt 0pt 0pt 0pt;'>

<p style='margin-left:0pt;text-indent:0pt;text-align:left;margin-bottom:0pt;'><font size=2>(2)</font></p> </td>

        <td valign=top style='padding:6.0pt 0pt 0pt 0pt;'>

<p style='margin-left:0pt;text-indent:0pt;text-align:left;margin-bottom:0pt;'><font size=2>passive income or loss, such as income or loss from an investment in a limited partnership as a limited partner; and</font></p> </td> </tr></table>
</div>






<div align=left>


