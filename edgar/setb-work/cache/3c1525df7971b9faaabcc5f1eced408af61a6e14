<TR STYLE="vertical-align: top">

          <TD STYLE="padding-left: 0pt; text-indent: -0pt" ROWSPAN=1 COLSPAN=1>Acquisition and Advisory Fees&nbsp;&#151;&nbsp;American Realty Capital Advisors, LLC<sup>&#040;5&#041;</sup><sup>&#040;6&#041;</sup></TD>

          <TD STYLE="width: 12px; vertical-align: text-bottom; text-align: center; border-bottom: none"><!-- GUTTER -->&nbsp;</TD>

          <TD ROWSPAN=1 COLSPAN=1 STYLE="text-align: left">We will pay to American Realty Capital Advisors, LLC a 2% of the contract purchase price of each property or asset.</TD>

          <TD STYLE="width: 12px; vertical-align: text-bottom; text-align: center; border-bottom: none"><!-- GUTTER -->&nbsp;</TD>

          <TD ROWSPAN=1 COLSPAN=1 STYLE="text-align: center">$35,400/$26,550,000</TD>

