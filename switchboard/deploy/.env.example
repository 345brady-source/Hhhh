# Domain that points at this server.
SWITCHBOARD_DOMAIN=mail.example.com
# Password for the Switchboard login page. Use a long one.
SWITCHBOARD_PASSWORD=change-me-to-something-long
# Your time zone, e.g. America/New_York
TZ=America/New_York
# Optional: enables the in-app Claude panel without pasting a key in Settings.
ANTHROPIC_API_KEY=
# Optional: OAuth apps for Gmail and Microsoft. When hosted, register these redirect URIs:
#   https://<SWITCHBOARD_DOMAIN>/oauth/google/callback     (Google: "Web application" client)
#   https://<SWITCHBOARD_DOMAIN>/oauth/microsoft/callback  (Microsoft: "Web" platform, with a client secret)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
